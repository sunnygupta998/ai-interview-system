import React, { useState, useEffect, useRef } from 'react';
import { useParams, useNavigate, useLocation } from 'react-router-dom';
import { interviewAPI } from '../../api/api';
import { FiMic, FiMicOff, FiVideo, FiVideoOff } from 'react-icons/fi';
import './LiveInterview.css';

const LiveInterview = () => {
  const { id } = useParams(); // test_id or resume_id depending on mode
  const navigate = useNavigate();
  const location = useLocation();
  const isPractice = location.pathname.includes('/practice/');
  
  const videoRef = useRef(null);
  const audioRef = useRef(new Audio());
  
  const [interviewId, setInterviewId] = useState(null);
  const [transcript, setTranscript] = useState([]);
  const [language, setLanguage] = useState('English');
  const [status, setStatus] = useState('initializing'); // initializing, active, processing, completed, error
  const [errorMsg, setErrorMsg] = useState('');
  const [tabSwitches, setTabSwitches] = useState(0);
  
  // Media states
  const [cameraOn, setCameraOn] = useState(true);
  const [micOn, setMicOn] = useState(true);
  const [stream, setStream] = useState(null);
  
  // Speech Recognition
  const recognitionRef = useRef(null);
  const [isRecording, setIsRecording] = useState(false);
  const [isTranscribing, setIsTranscribing] = useState(false);
  const mediaRecorderRef = useRef(null);
  const audioChunksRef = useRef([]);

  // Start interview and get media on mount
  useEffect(() => {
    let activeStream = null;
    
    const initInterview = async () => {
      try {
        // 1. Request Camera/Mic access
        activeStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        setStream(activeStream);

        // 2. Call backend to start interview
        let res;
        if (isPractice) {
          res = await interviewAPI.startPractice(id);
        } else {
          res = await interviewAPI.start(id);
        }
        const data = res.data;
        
        if (data.status === 'completed') {
          setStatus('completed');
          setTranscript(data.transcript || []);
          return;
        }
        
        setInterviewId(data.interview_id);
        setTranscript(data.transcript);
        setLanguage(data.language);
        setStatus('active');
        
                
        // 4. Speak first question
        if (data.first_question) {
          speakText(data.first_question, data.language);
        }
      } catch (err) {
        console.error("Initialization error:", err);
        setStatus('error');
        if (err.name === 'NotAllowedError' || err.name === 'NotFoundError') {
          setErrorMsg("Camera and Microphone access is required for the live interview.");
        } else {
          setErrorMsg("Failed to start the interview session.");
        }
      }
    };

    initInterview();

    // Cleanup
    return () => {
      if (activeStream) {
        activeStream.getTracks().forEach(track => track.stop());
      }
      if (mediaRecorderRef.current && mediaRecorderRef.current.state === 'recording') {
        mediaRecorderRef.current.stop();
      }
      if (audioRef.current) {
        audioRef.current.pause();
        audioRef.current.src = '';
      }
      window.speechSynthesis.cancel();
    };
  }, [id, isPractice]);

  // Proctoring logic: Track tab switches if not in practice mode
  useEffect(() => {
    if (isPractice) return;

    const handleVisibilityChange = () => {
      if (document.hidden) {
        setTabSwitches(prev => prev + 1);
      } else {
        alert("WARNING: You are not allowed to switch tabs during the live interview. This action has been recorded and flagged for the administrator.");
      }
    };

    document.addEventListener('visibilitychange', handleVisibilityChange);
    return () => {
      document.removeEventListener('visibilitychange', handleVisibilityChange);
    };
  }, [isPractice]);

  // Bind the media stream to the video element whenever the UI changes from 'initializing' to 'active'
  useEffect(() => {
    if (videoRef.current && stream) {
      videoRef.current.srcObject = stream;
    }
  }, [stream, status]);

  const [answerText, setAnswerText] = useState('');

  const speakText = async (text, lang) => {
    try {
      if (audioRef.current) {
        audioRef.current.pause();
      }
      
      const res = await interviewAPI.getTTS(text, lang);
      const url = URL.createObjectURL(res.data);
      audioRef.current.src = url;
      await audioRef.current.play();
      
    } catch (err) {
      console.error("TTS playback error:", err);
      // Fallback to browser TTS if Groq TTS fails
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      
      // Try to find a premium, human-like voice
      const voices = window.speechSynthesis.getVoices();
      let selectedVoice = null;
      
      if (lang === 'English') {
        selectedVoice = voices.find(v => v.name.includes('Google UK English Female')) ||
                        voices.find(v => v.name.includes('Google US English')) ||
                        voices.find(v => v.name.includes('Microsoft Zira') || v.name.includes('Microsoft Aria')) ||
                        voices.find(v => v.lang === 'en-US' && v.name.includes('Female')) ||
                        voices.find(v => v.lang.startsWith('en'));
        utterance.lang = 'en-US';
      } else if (lang === 'Hindi' || lang === 'Both') {
        selectedVoice = voices.find(v => v.name.includes('Google हिन्दी')) ||
                        voices.find(v => v.lang.startsWith('hi'));
        utterance.lang = 'hi-IN';
      } else if (lang === 'Spanish') {
        selectedVoice = voices.find(v => v.lang.startsWith('es'));
        utterance.lang = 'es-ES';
      } else if (lang === 'French') {
        selectedVoice = voices.find(v => v.lang.startsWith('fr'));
        utterance.lang = 'fr-FR';
      }
      
      if (selectedVoice) {
        utterance.voice = selectedVoice;
      }
      
      utterance.rate = 0.95; // Slightly slower for better human cadence
      window.speechSynthesis.speak(utterance);
    }
  };

  const handleCandidateResponse = async (text = null) => {
    const submitText = text || answerText;
    if (!submitText.trim() || status !== 'active') return;
    
    try {
      setStatus('processing');
      if (mediaRecorderRef.current && isRecording) {
        mediaRecorderRef.current.stop();
        setIsRecording(false);
      }
      
      setAnswerText(''); // clear input
      
      // Optimistically update transcript
      const newMsg = { role: 'candidate', content: submitText, timestamp: new Date().toISOString() };
      setTranscript(prev => [...prev, newMsg]);
      
      const res = await interviewAPI.respond(interviewId, submitText);
      const data = res.data;
      
      setTranscript(data.transcript);
      
      if (data.is_complete) {
        setStatus('completed');
        speakText(data.final_message, language);
      } else {
        setStatus('active');
        speakText(data.next_message, language);
      }
    } catch (err) {
      console.error("Error submitting response:", err);
      setStatus('active');
    }
  };

  const toggleMic = () => {
    if (stream) {
      const audioTrack = stream.getAudioTracks()[0];
      if (audioTrack) {
        audioTrack.enabled = !audioTrack.enabled;
        setMicOn(audioTrack.enabled);
        
        if (!audioTrack.enabled && isRecording && mediaRecorderRef.current) {
          mediaRecorderRef.current.stop();
          setIsRecording(false);
        }
      }
    }
  };

  const toggleCamera = () => {
    if (stream) {
      const videoTrack = stream.getVideoTracks()[0];
      if (videoTrack) {
        videoTrack.enabled = !videoTrack.enabled;
        setCameraOn(videoTrack.enabled);
      }
    }
  };
  
  const toggleRecording = () => {
    if (!stream || status !== 'active' || !micOn) return;
    
    if (isRecording) {
      if (mediaRecorderRef.current && mediaRecorderRef.current.state === 'recording') {
        mediaRecorderRef.current.stop();
        setIsRecording(false);
      }
    } else {
      if (audioRef.current) audioRef.current.pause(); // Stop AI speaking if user interrupts
      window.speechSynthesis.cancel(); 
      audioChunksRef.current = [];
      
      try {
        // Let browser choose its preferred audio mimeType automatically
        const mediaRecorder = new MediaRecorder(stream);
        mediaRecorderRef.current = mediaRecorder;
        
        mediaRecorder.ondataavailable = (event) => {
          if (event.data.size > 0) {
            audioChunksRef.current.push(event.data);
          }
        };
        
        mediaRecorder.onstop = async () => {
          // Use the mimetype that the browser actually used to record
          const audioBlob = new Blob(audioChunksRef.current, { type: mediaRecorder.mimeType });
          setIsTranscribing(true);
          try {
            const res = await interviewAPI.transcribe(audioBlob);
            if (res.data.text) {
              setAnswerText(prev => prev + (prev ? ' ' : '') + res.data.text);
            }
          } catch (err) {
            console.error("Transcription error:", err);
            setStatus('error');
            setErrorMsg("Transcription failed. Please try again or type your answer.");
          } finally {
            setIsTranscribing(false);
          }
        };
        
        mediaRecorder.start();
        setIsRecording(true);
      } catch (e) {
        console.error("MediaRecorder start error:", e);
        setStatus('error');
        setErrorMsg("Your browser does not support audio recording. " + e.message);
      }
    }
  };

  if (status === 'initializing') {
    return (
      <div className="live-interview-container initializing-state">
        <div className="spinner"></div>
        <p>Connecting to secure AI Interview server...</p>
      </div>
    );
  }

  if (status === 'error') {
    return (
      <div className="live-interview-container error-state">
        <h3>Interview Connection Failed</h3>
        <p>{errorMsg}</p>
        <button onClick={() => navigate('/candidate/dashboard')} className="btn-primary">
          Return to Dashboard
        </button>
      </div>
    );
  }

  const proctoringStyles = !isPractice ? { userSelect: 'none' } : {};
  const handleProctoringEvents = (e) => {
    if (!isPractice) {
      e.preventDefault();
      alert('Copying/pasting is disabled during the official live interview.');
    }
  };

  return (
    <div 
      className="live-interview-container animate-fade"
      style={proctoringStyles}
      onCopy={handleProctoringEvents}
      onCut={handleProctoringEvents}
      onPaste={handleProctoringEvents}
    >
      <div className="interview-main">
        {/* Video Section */}
        <div className="video-section">
          <div className="video-wrapper">
            <video 
              ref={videoRef} 
              autoPlay 
              playsInline 
              muted 
              className={`webcam-video ${!cameraOn ? 'video-off' : ''}`} 
            />
            {!cameraOn && <div className="video-off-overlay">Camera Disabled</div>}
            
            <div className="video-controls">
              <button onClick={toggleMic} className={`control-btn ${!micOn ? 'btn-danger' : 'btn-secondary'}`}>
                {micOn ? <FiMic /> : <FiMicOff />}
              </button>
              <button onClick={toggleCamera} className={`control-btn ${!cameraOn ? 'btn-danger' : 'btn-secondary'}`}>
                {cameraOn ? <FiVideo /> : <FiVideoOff />}
              </button>
            </div>
          </div>
          
          <div className="status-indicator">
            {status === 'completed' ? (
              <span className="badge badge-success">Interview Completed</span>
            ) : status === 'processing' ? (
              <span className="badge badge-warning">AI is thinking...</span>
            ) : isRecording ? (
              <span className="badge badge-error animate-pulse">Listening...</span>
            ) : (
              <span className="badge badge-secondary">Ready</span>
            )}
          </div>
          
          {status === 'active' && (
            <>
              <button 
                onClick={async () => {
                  if (window.confirm('Are you sure you want to end the interview early?')) {
                    setStatus('processing');
                    if (stream) stream.getTracks().forEach(track => track.stop());
                    if (mediaRecorderRef.current && mediaRecorderRef.current.state === 'recording') mediaRecorderRef.current.stop();
                    if (audioRef.current) audioRef.current.pause();
                    window.speechSynthesis.cancel();
                    try {
                      await interviewAPI.end(interviewId, { tab_switches: tabSwitches });
                    } catch(e) {
                      console.error("Failed to forcefully end interview:", e);
                    }
                    if (isPractice) {
                      navigate('/candidate/dashboard');
                    } else {
                      navigate(`/candidate/results/${id}`);
                    }
                  }
                }} 
                disabled={status === 'processing'}
                className="btn-primary manual-talk-btn"
                style={{ background: 'var(--error)', backgroundImage: 'none', color: 'white', left: '20px', right: 'auto' }}
              >
                End AI Interview
              </button>

              {micOn && (
                <button 
                  onClick={toggleRecording} 
                  className={`btn-primary manual-talk-btn ${isRecording ? 'listening' : ''}`}
                >
                  {isRecording ? 'Stop Recording' : 'Start Recording'}
                </button>
              )}
            </>
          )}
          
          {isTranscribing && (
            <div className="live-caption">
              Transcribing audio with AI...
            </div>
          )}
        </div>

        {/* Transcript Section */}
        <div className="transcript-section glass-card" style={{ display: 'flex', flexDirection: 'column' }}>
          <h3>Interview Transcript</h3>
          <div className="transcript-scroll-area">
            {transcript.map((msg, idx) => (
              <div key={idx} className={`chat-bubble ${msg.role === 'ai' ? 'ai-bubble' : 'candidate-bubble'}`}>
                <div className="bubble-header">
                  {msg.role === 'ai' ? 'AI Recruiter' : 'You'}
                </div>
                <div className="bubble-content">
                  {msg.content}
                </div>
              </div>
            ))}
            {status === 'processing' && (
              <div className="chat-bubble ai-bubble processing-bubble">
                <div className="typing-indicator">
                  <span></span><span></span><span></span>
                </div>
              </div>
            )}
          </div>
          
          {status === 'active' && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem', marginTop: '1rem' }}>
              <div className="manual-answer-input" style={{ display: 'flex', gap: '0.5rem' }}>
                <textarea 
                  value={answerText}
                  onChange={(e) => setAnswerText(e.target.value)}
                  placeholder="Speak or type your answer here..."
                  style={{ flex: 1, padding: '0.75rem', borderRadius: '8px', background: 'rgba(0,0,0,0.3)', border: '1px solid var(--border)', color: 'white', minHeight: '60px' }}
                />
                <button 
                  onClick={() => handleCandidateResponse()} 
                  className="btn-primary"
                  disabled={!answerText.trim()}
                >
                  Submit Answer
                </button>
              </div>
            </div>
          )}
          
          {status === 'completed' && (
            <div className="interview-complete-action">
              <button 
                onClick={() => {
                  if (isPractice) {
                    navigate('/candidate/dashboard');
                  } else {
                    navigate(`/candidate/results/${id}`);
                  }
                }} 
                className="btn-primary" 
                style={{ width: '100%' }}
              >
                {isPractice ? 'Finish Practice & Return to Dashboard' : 'Finish & View Results'}
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default LiveInterview;
